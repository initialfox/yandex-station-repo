#!/bin/sh
DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
export LD_LIBRARY_PATH="$DIR/lib:${LD_LIBRARY_PATH:-}"
if [ -x "$DIR/bin/bash" ] && [ -x "$DIR/lib/ld-musl-aarch64.so.1" ]; then
  exec "$DIR/lib/ld-musl-aarch64.so.1" "$DIR/bin/bash" "$DIR/bin/neofetch" "$@"
fi
if command -v bash >/dev/null 2>&1; then
  exec bash "$DIR/bin/neofetch" "$@"
fi
echo "neofetch: нужен bash. Попробуй: apkg install fastfetch" >&2
exit 1
